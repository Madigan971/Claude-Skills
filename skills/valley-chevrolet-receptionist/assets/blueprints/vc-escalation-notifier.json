{
  "name": "VC Escalation Notifier",
  "description": "Receives ESCALATION_DATA JSON from the inbound router and sends a priority email to the service advisor(s) with full customer and lead context so they can follow up promptly.",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "{{ESCALATION_WEBHOOK_ID}}"
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "hook": { "label": "VC Escalation Webhook" }
          }
        }
      }
    },
    {
      "id": 2,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{1.body}}",
        "type": "auto"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 }
      }
    },
    {
      "id": 3,
      "module": "tools:SetVariable",
      "version": 1,
      "parameters": {},
      "mapper": {
        "name": "urgency_prefix",
        "scope": "roundtrip",
        "value": "{{if(2.reason == \"complaint\", \"🚨 COMPLAINT\", if(2.reason == \"human_requested\", \"📞 CALLBACK REQUEST\", if(2.reason == \"status_inquiry\", \"🔍 STATUS INQUIRY\", \"📋 LEAD\")))}}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 }
      }
    },
    {
      "id": 4,
      "module": "gmail:ActionSendEmail",
      "version": 1,
      "parameters": {
        "account": "{{GMAIL_CONNECTION_ID}}"
      },
      "mapper": {
        "to": "{{ADVISOR_EMAIL}}",
        "from": "{{FROM_EMAIL}}",
        "subject": "[{{3.urgency_prefix}}] {{2.customer_name}} — {{2.vehicle}}",
        "content": "<h2 style=\"color:{{if(2.reason == 'complaint', '#c0392b', '#2c3e50')}};\">{{3.urgency_prefix}}: Follow-Up Required</h2><table style=\"border-collapse:collapse;font-family:Arial,sans-serif;width:100%;max-width:600px;\"><tr style=\"background:#f8f9fa;\"><td style=\"padding:8px 16px 8px 0;\"><strong>Customer:</strong></td><td style=\"padding:8px 0;\">{{2.customer_name}}</td></tr><tr><td style=\"padding:8px 16px 8px 0;\"><strong>Phone:</strong></td><td style=\"padding:8px 0;\"><a href=\"tel:{{2.phone}}\">{{2.phone}}</a></td></tr><tr style=\"background:#f8f9fa;\"><td style=\"padding:8px 16px 8px 0;\"><strong>Email:</strong></td><td style=\"padding:8px 0;\"><a href=\"mailto:{{2.email}}\">{{2.email}}</a></td></tr><tr><td style=\"padding:8px 16px 8px 0;\"><strong>Vehicle:</strong></td><td style=\"padding:8px 0;\">{{2.vehicle}}</td></tr><tr style=\"background:#f8f9fa;\"><td style=\"padding:8px 16px 8px 0;\"><strong>Reason:</strong></td><td style=\"padding:8px 0;\">{{2.reason}}</td></tr><tr><td style=\"padding:8px 16px 8px 0;\"><strong>Summary:</strong></td><td style=\"padding:8px 0;\">{{2.summary}}</td></tr><tr style=\"background:#f8f9fa;\"><td style=\"padding:8px 16px 8px 0;\"><strong>Received:</strong></td><td style=\"padding:8px 0;\">{{formatDate(now, \"MMM D, YYYY [at] h:mm A z\", \"America/New_York\")}}</td></tr></table><hr style=\"margin:24px 0;\"><p style=\"color:#666;font-size:13px;\">This notification was generated by the Valley Chevrolet AI Receptionist. Please follow up with the customer as soon as possible.</p>",
        "type": "html",
        "importance": "{{if(2.reason == \"complaint\", \"high\", \"normal\")}}"
      },
      "metadata": {
        "designer": { "x": 900, "y": -200 }
      }
    },
    {
      "id": 5,
      "module": "google-sheets:appendRow",
      "version": 2,
      "parameters": {
        "spreadsheetId": "{{ESCALATION_SHEET_ID}}",
        "sheetId": "Sheet1",
        "includesHeaders": true,
        "valueRenderOption": "FORMATTED_VALUE",
        "insertDataOption": "INSERT_ROWS"
      },
      "mapper": {
        "values": {
          "Timestamp": "{{formatDate(now, \"YYYY-MM-DD HH:mm:ss\", \"America/New_York\")}}",
          "Reason": "{{2.reason}}",
          "Customer Name": "{{2.customer_name}}",
          "Phone": "{{2.phone}}",
          "Email": "{{2.email}}",
          "Vehicle": "{{2.vehicle}}",
          "Summary": "{{2.summary}}",
          "Status": "New"
        }
      },
      "metadata": {
        "designer": { "x": 900, "y": 200 },
        "notes": "Optional: log leads to Google Sheets. Delete this module if not needed."
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us1.make.com"
  },
  "_setup_variables": {
    "ESCALATION_WEBHOOK_ID": "Replace with Make webhook ID after creating the webhook",
    "GMAIL_CONNECTION_ID": "Your Gmail connection ID in Make",
    "FROM_EMAIL": "service@valleychevrolet.com",
    "ADVISOR_EMAIL": "advisor@valleychevrolet.com (comma-separate for multiple)",
    "ESCALATION_SHEET_ID": "Google Sheets document ID for lead log (optional — delete module 5 if not using)"
  }
}
